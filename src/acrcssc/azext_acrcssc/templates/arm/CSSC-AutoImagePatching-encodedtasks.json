      "location": "[parameters('AcrLocation')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "tags": {
        "cssc": "true",
        "clienttracking": "true"
      },
      "properties": {
        "platform": {
          "os": "linux",
          "architecture": "amd64"
        },
        "agentConfiguration": {
